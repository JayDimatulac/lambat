# Connect to Postgres via the Supabase transaction-mode pooler
DATABASE_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:6543/postgres?pgbouncer=true"

# Session-mode pooler, used for migrations
DIRECT_URL="postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@YOUR_POOLER_HOST:5432/postgres"

# At least 32 random characters
JWT_SECRET=change-me-to-64-random-characters

# Allowed website addresses, separated by commas
CORS_ORIGINS=http://localhost:5173

# AI explanations (leave LLM_API_KEY empty to use the template text only)
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_MODEL=gemini-3.1-flash-lite