generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  FISHERFOLK
  BUYER
  ADMIN
  ORGANIZATION
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum CatchStatus {
  ACTIVE
  SOLD
  REDISTRIBUTED
  PROCESSED
  DISCARDED
}

model User {
  id           String        @id @default(cuid())
  mobile       String        @unique
  email        String?       @unique
  passwordHash String
  role         Role
  status       AccountStatus @default(ACTIVE)
  name         String
  barangay     String

  // fisherfolk only (optional)
  boatOrGear   String?
  fishingArea  String?

  // buyer only (optional)
  businessName String?
  buyerType    String?

  catches      CatchBatch[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Species {
  id                 String       @id @default(cuid())
  englishName        String       @unique
  scientificName     String
  localNames         String[]
  shelfLifeHoursAt0C Int?
  catches            CatchBatch[]
}

model CatchBatch {
  id        String      @id @default(cuid())
  userId    String
  speciesId String
  kilos     Float
  iceSacks  Float?
  caughtAt  DateTime
  status    CatchStatus @default(ACTIVE)
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id])
  species   Species     @relation(fields: [speciesId], references: [id])

  @@index([userId])
  @@index([speciesId])
}