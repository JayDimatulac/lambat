generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  FISHERFOLK
  BUYER
  ADMIN
  ORGANIZATION
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum CatchStatus {
  ACTIVE
  SOLD
  REDISTRIBUTED
  PROCESSED
  DISCARDED
}

enum AdvisorySeverity {
  INFO
  WARNING
  DANGER
}

enum NotificationType {
  ADVISORY
  HIGH_RISK
  OFFER
  ORDER
  SYSTEM
}

model User {
  id           String        @id @default(cuid())
  mobile       String        @unique
  email        String?       @unique
  passwordHash String
  role         Role
  status       AccountStatus @default(ACTIVE)
  name         String
  barangay     String

  // fisherfolk only (optional)
  boatOrGear   String?
  fishingArea  String?

  // buyer only (optional)
  businessName String?
  buyerType    String?

  catches       CatchBatch[]
  advisories    Advisory[]
  notifications Notification[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Species {
  id                 String       @id @default(cuid())
  englishName        String       @unique
  scientificName     String
  localNames         String[]
  shelfLifeHoursAt0C Int?
  catches            CatchBatch[]
  pathways           Pathway[]
}

model CatchBatch {
  id        String      @id @default(cuid())
  userId    String
  speciesId String
  kilos     Float
  iceSacks  Float?
  caughtAt  DateTime
  status    CatchStatus @default(ACTIVE)
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id])
  species   Species     @relation(fields: [speciesId], references: [id])

  @@index([userId])
  @@index([speciesId])
}

model Advisory {
  id          String           @id @default(cuid())
  title       String
  body        String
  severity    AdvisorySeverity @default(INFO)
  audience    Role?
  active      Boolean          @default(true)
  expiresAt   DateTime?
  createdById String
  createdAt   DateTime         @default(now())

  createdBy     User           @relation(fields: [createdById], references: [id])
  notifications Notification[]

  @@index([active, createdAt])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  advisoryId String?
  readAt     DateTime?
  createdAt  DateTime         @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  advisory Advisory? @relation(fields: [advisoryId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
}
enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Pathway {
  id                 String      @id @default(cuid())
  speciesId          String
  name               String
  allowedRisks       RiskLevel[]
  requiredConditions String
  avoidConditions    String
  recommendation     String
  source             String?
  active             Boolean     @default(true)
  createdAt          DateTime    @default(now())

  species Species @relation(fields: [speciesId], references: [id], onDelete: Cascade)

  @@unique([speciesId, name])
}